{
  "name": "omni-commerce",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter @omni/authz-types build && pnpm --dir backend/apps/api exec vitest run --root ../../tests/isolation cross-tenant",
    "test:eval": "uv run --directory backend/apps/ai python ../../tests/eval/run_stub.py",
    "test:e2e:local": "node infra/scripts/local-e2e-smoke.mjs",
    "ports:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/sync-local-env-ports.ps1",
    "dev": "turbo run dev --parallel",
    "dev:ui": "node infra/scripts/dev-ui-preview.mjs",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/dev-local.ps1",
    "dev:local:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/dev-local.ps1 -FreshWeb",
    "dev:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/dev-local.ps1 -Stop"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "7.0.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
