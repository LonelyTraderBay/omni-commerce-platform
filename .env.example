# API / shared
# Ports LOCKED for this repo — see infra/config/local-ports.json (pnpm run ports:sync)
NODE_ENV=development
PORT=4701
SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
TOKEN_ENCRYPTION_KEY=replace-with-32-plus-character-dev-key
SERVICE_M2M_KEY=replace-with-16-plus-character-dev-key
AI_BASE_URL=http://127.0.0.1:4702
WEB_ORIGIN=http://127.0.0.1:4700
# Product AI runtime provider only — this does not configure OpenAI Codex.
# Local/dev/test remains offline with `auto`; dev-local.ps1 forces `stub`.
AI_PROVIDER=auto
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Locked Inngest dev-server port (infra/config/local-ports.json) — SDK defaults to :8288 otherwise,
# which nothing listens on here and causes a permanent "Failed to register" ECONNREFUSED loop.
INNGEST_DEV=http://127.0.0.1:4788
SENTRY_DSN=
PLATFORM_ADMIN_EMAILS=
# Every model that may actually run must be listed here — including the OpenAI
# failover model. OpenAI failover resolves gemini-* -> gpt-* (see
# backend/apps/ai/app/infra/llm/openai.py GEMINI_TO_OPENAI_FALLBACK) and allowlist-checks
# the RESOLVED model, so the OpenAI fallback is included below.
AI_MODEL_ALLOWLIST=gemini-2.0-flash,advisor-stub,gpt-4o-mini
DEFAULT_AI_DRAFT_MAX_AMOUNT_VND=5000000
# Meta — OAuth redirect = web (:4700); webhook = API /v1/webhooks/meta (:4701)
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-8-plus-char-verify-token
META_REDIRECT_URI=http://127.0.0.1:4700/settings/channels/callback
META_GRAPH_VERSION=v21.0
META_INTEGRATION_MODE=stub

# Zalo OA — connect uses an existing OA access token. The webhook endpoint fails
# closed: leave ZALO_WEBHOOK_SECRET empty to keep /v1/channels/zalo/webhook
# disabled, or set it to enable Zalo inbound (callers must send the same value in
# the x-zalo-webhook-secret header).
ZALO_WEBHOOK_SECRET=

# E-invoice — stub (default) or http_sandbox engineering path (not live tax compliance).
# EINVOICE_PROVIDER=stub|http_sandbox — default when POST /v1/einvoice/issue omits provider.
EINVOICE_PROVIDER=stub
# Optional POST target for http_sandbox (2xx=success, ~10s timeout). Unset → deterministic stub success.
EINVOICE_SANDBOX_URL=

# Web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4701

# AI service
CORE_BASE_URL=http://127.0.0.1:4701
APP_ENV=local
# When GEMINI_API_KEY is empty and APP_ENV is local/dev/test, AI uses deterministic
# stub embeddings (768-d) for knowledge_chunks — local/dev only, NOT Gemini quality.
# Production (APP_ENV/NODE_ENV=production) always refuses stub; set a real key there.
# EMBEDDINGS_ALLOW_STUB=1 also enables stub on non-prod envs that are not localish.
EMBEDDINGS_ALLOW_STUB=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DAILY_SPEND_CAP_USD=0
LLM_MONTHLY_SPEND_CAP_USD=0
GEMINI_USD_PER_1K_INPUT_TOKENS=0.0001
GEMINI_USD_PER_1K_OUTPUT_TOKENS=0.0004
# Embeddings bill input tokens only; defaults to the completion input rate.
GEMINI_USD_PER_1K_EMBEDDING_TOKENS=0.0001
# Per-process JSON counter — the cap is per uvicorn worker, not global.
LLM_SPEND_COUNTER_PATH=.llm-spend.json
